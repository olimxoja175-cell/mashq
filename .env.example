# ================= WORLDVOICE configuration =================
# Copy to .env (docker compose) or backend/.env (local run). Never commit real values.

# --- mode ---
# true  = development: demo accounts, MFA code hints, SQLite default, dev secrets allowed
# false = production: refuses to start without real secrets; no demo data
WV_DEV_MODE=false
WV_DOMAIN=worldvoice.example.gov

# --- secrets (generate each with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())") ---
WV_SECRET_KEY=change-me-long-random-string
# AES-256-GCM key for transcripts, TOTP secrets, voice-profile ids (base64 of 32 bytes). Prefer injecting from a KMS/Vault.
WV_DATA_KEY=
WV_DATA_KEY_ID=v1
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
WV_TURN_SECRET=change-me

# --- sessions ---
WV_SESSION_ABSOLUTE_HOURS=12
WV_SESSION_IDLE_MINUTES=30
WV_MAX_FAILED_LOGINS=5
WV_LOCKOUT_MINUTES=15

# --- WebRTC ---
# Leave STUN empty for closed networks; set your own STUN/TURN for internet use.
WV_STUN_URLS=[]
WV_MAX_MESH_PARTICIPANTS=6

# --- AI providers (leave empty to run in clearly-labelled development mode) ---
# Translation: Anthropic Claude
ANTHROPIC_API_KEY=
WV_ANTHROPIC_MODEL=claude-opus-5-5
# low = fastest; raise to medium/high for higher-stakes sessions at the cost of latency
WV_ANTHROPIC_EFFORT=low
# Speech recognition + language identification (Whisper) and generic synthetic voice
OPENAI_API_KEY=
WV_OPENAI_STT_MODEL=whisper-1
WV_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Consent-based voice identity (instant voice cloning)
ELEVENLABS_API_KEY=
WV_ELEVENLABS_MODEL=eleven_multilingual_v2
# Languages the chosen ElevenLabs model speaks (verify in provider docs); others fall back to the generic voice
WV_ELEVENLABS_LANGUAGES=["zh","en","ru","ar","fr","de","es","tr","hi","ja","ko","pt"]

# Google Gemini: one key covers speech recognition, translation and speech synthesis
# (free tier available; used for whatever the paid keys above do not cover)
GEMINI_API_KEY=
WV_GEMINI_MODEL=gemini-3.1-flash-lite
WV_GEMINI_STT_MODEL=gemini-3.1-flash-lite
WV_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
WV_GEMINI_TTS_VOICE=Charon

# provider selection: auto picks the real provider when its key is present
WV_STT_PROVIDER=auto        # auto | openai | gemini | browser
WV_TRANSLATION_PROVIDER=auto
WV_TTS_PROVIDER=auto
WV_UNCERTAINTY_THRESHOLD=0.75
